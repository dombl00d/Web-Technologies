    <!-- Bootstrap 5 JavaScript bundle -->
    https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js    </script>

    <script>

        /*
         * jQuery Enhancements
         */

        $(document).ready(function () {

            /*
             * Hide the confirmation section until the
             * form has been successfully submitted.
             */

            $("#confirmationSection").hide();

            /*
             * Apply an animation to the certification image
             * when a pointer enters or leaves the image.
             */

            $("#certificationImage").hover(

                function () {

                    $(this).stop(true).fadeTo(300, 0.7);

                },

                function () {

                    $(this).stop(true).fadeTo(300, 1);

                }

            );

        });


        /*
         * Bootstrap Form Validation and Submission
         */

        const questionForm =
            document.getElementById("questionForm");

        questionForm.addEventListener(
            "submit",
            function (event) {

                event.preventDefault();

                /*
                 * Prevent submission and display Bootstrap's
                 * validation styling when the form is invalid.
                 */

                if (!questionForm.checkValidity()) {

                    event.stopPropagation();

                    questionForm.classList.add(
                        "was-validated"
                    );

                    return;

                }

                const firstName =
                    document
                        .getElementById("firstname")
                        .value
                        .trim();

                const surname =
                    document
                        .getElementById("surname")
                        .value
                        .trim();

                const question =
                    document
                        .getElementById("question")
                        .value
                        .trim();

                const questionType =
                    document.querySelector(
                        'input[name="questiontype"]:checked'
                    ).value;

                /*
                 * Use textContent when adding user-entered
                 * content to reduce the risk of HTML injection.
                 */

                const confirmation =
                    document.getElementById("confirmation");

                confirmation.replaceChildren();

                const thankYouMessage =
                    document.createElement("p");

                const thankYouText =
                    document.createElement("strong");

                thankYouText.textContent =
                    "Thank you " +
                    firstName +
                    " " +
                    surname +
                    ".";

                thankYouMessage.appendChild(thankYouText);

                const receivedMessage =
                    document.createElement("p");

                receivedMessage.textContent =
                    "Your question has been successfully received.";

                const typeMessage =
                    document.createElement("p");

                const typeLabel =
                    document.createElement("strong");

                typeLabel.textContent =
                    "Question Type: ";

                typeMessage.appendChild(typeLabel);

                typeMessage.appendChild(
                    document.createTextNode(questionType)
                );

                const questionMessage =
                    document.createElement("p");

                questionMessage.classList.add("mb-0");

                const questionLabel =
                    document.createElement("strong");

                questionLabel.textContent =
                    "Your Question: ";

                questionMessage.appendChild(questionLabel);

                questionMessage.appendChild(
                    document.createTextNode(question)
                );

                confirmation.append(
                    thankYouMessage,
                    receivedMessage,
                    typeMessage,
                    questionMessage
                );

                /*
                 * Display the confirmation using a jQuery
                 * animation and move keyboard focus to it.
                 */

                $("#confirmationSection")
                    .stop(true, true)
                    .slideDown(1000, function () {

                        document
                            .getElementById(
                                "confirmationSection"
                            )
                            .focus();

                    });

                questionForm.classList.add(
                    "was-validated"
                );

            }
        );


        /*
         * Clear validation and confirmation when
         * the form is reset.
         */

        questionForm.addEventListener(
            "reset",
            function () {

                questionForm.classList.remove(
                    "was-validated"
                );

                $("#confirmationSection")
                    .stop(true, true)
                    .slideUp(500);

            }
        );


        /*
         * Technology News API Integration
         */

        const newsContainer =
            document.getElementById("newsContainer");

        fetch(
            "https://api.spaceflightnewsapi.net/v4/articles/?limit=1"
        )

            .then(function (response) {

                if (!response.ok) {

                    throw new Error(
                        "Unable to retrieve the latest article."
                    );

                }

                return response.json();

            })

            .then(function (data) {

                if (
                    !data.results ||
                    data.results.length === 0
                ) {

                    throw new Error(
                        "No technology articles were returned."
                    );

                }

                const article = data.results[0];

                /*
                 * Construct the API result using DOM methods
                 * rather than inserting untrusted API content
                 * through innerHTML.
                 */

                const cardBody =
                    document.createElement("div");

                cardBody.className =
                    "card-body p-4";

                const articleElement =
                    document.createElement("article");

                const articleTitle =
                    document.createElement("h3");

                articleTitle.className =
                    "h4 card-title";

                articleTitle.textContent =
                    article.title;

                const articleSummary =
                    document.createElement("p");

                articleSummary.className =
                    "card-text";

                articleSummary.textContent =
                    article.summary;

                const source =
                    document.createElement("p");

                const sourceLabel =
                    document.createElement("strong");

                sourceLabel.textContent =
                    "Source: ";

                source.appendChild(sourceLabel);

                source.appendChild(
                    document.createTextNode(
                        article.news_site
                    )
                );

                const published =
                    document.createElement("p");

                const publishedLabel =
                    document.createElement("strong");

                publishedLabel.textContent =
                    "Published: ";

                published.appendChild(publishedLabel);

                published.appendChild(
                    document.createTextNode(
                        new Date(
                            article.published_at
                        ).toLocaleDateString("en-GB")
                    )
                );

                const articleLink =
                    document.createElement("a");

                articleLink.className =
                    "btn btn-primary";

                articleLink.href =
                    article.url;

                articleLink.target =
                    "_blank";

                articleLink.rel =
                    "noopener noreferrer";

                articleLink.textContent =
                    "Read Full Article";

                const newTabText =
                    document.createElement("span");

                newTabText.className =
                    "visually-hidden";

                newTabText.textContent =
                    " (opens in a new tab)";

                articleLink.appendChild(newTabText);

                articleElement.append(
                    articleTitle,
                    articleSummary,
                    source,
                    published,
                    articleLink
                );

                cardBody.appendChild(
                    articleElement
                );

                newsContainer.replaceChildren(
                    cardBody
                );

                newsContainer.setAttribute(
                    "aria-busy",
                    "false"
                );

            })

            .catch(function (error) {

                console.error(error);

                const errorBody =
                    document.createElement("div");

                errorBody.className =
                    "card-body";

                const errorMessage =
                    document.createElement("p");

                errorMessage.className =
                    "alert alert-warning mb-0";

                errorMessage.setAttribute(
                    "role",
                    "alert"
                );

                errorMessage.textContent =
                    "The latest technology article could not be loaded.";

                errorBody.appendChild(
                    errorMessage
                );

                newsContainer.replaceChildren(
                    errorBody
                );

                newsContainer.setAttribute(
                    "aria-busy",
                    "false"
                );

            });

    </script>

